{
  "name": "deepseek-codex-gui",
  "version": "1.0.24",
  "description": "DeepSeek V4 Flash powered Codex desktop client",
  "main": "main.js",
  "scripts": {
    "test": "node git-review-manager.test.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "DeepSeek Codex",
  "build": {
    "appId": "com.widdie.deepseekcodex",
    "productName": "DeepSeek Codex",
    "files": [
      "**/*",
      "!backup-*/**",
      "!design-qa/**",
      "!design-qa.md",
      "!dist/**"
    ],
    "asarUnpack": [
      "resources/codex-cli/*.tgz",
      "resources/mihomo/mihomo.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/brand/deepseek-codex-app.ico",
      "artifactName": "DeepSeek-Codex-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerIcon": "assets/brand/deepseek-codex-app.ico",
      "uninstallerIcon": "assets/brand/deepseek-codex-app.ico",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "shortcutName": "DeepSeek Codex",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "DeepSeek Codex ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "Slimswd",
      "repo": "DeepSeek-Codex-GUI",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "electron-updater": "^6.8.9"
  }
}
